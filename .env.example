# AI-Powered Customer Sales Analytics Platform
# Copy this file to `.env` and replace the placeholders with real credentials.
# `.env` is git-ignored; never commit real secrets.

# --- MySQL data warehouse ---
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=sales_analytics_db

# --- Google Gemini (AI Copilot) ---
# Optional. When empty, the dashboard runs in Smart Deterministic Analyst mode.
GEMINI_API_KEY=your_gemini_api_key

# --- Embedded analytics engine (optional) ---
# MySQL is preferred; when it is unreachable the dashboard persists data here.
# ANALYTICS_SQLITE_PATH=data/processed/analytics_live.db
